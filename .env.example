# --- Svetainė (NEXT_PUBLIC_* įrašomi kompiliuojant – nustatykite prieš `npm run build`) ---
NEXT_PUBLIC_SITE_URL=https://techvalymas.lt
NEXT_PUBLIC_SITE_NAME=TechValymas
NEXT_PUBLIC_CITY=Vilnius
NEXT_PUBLIC_PHONE=+370 600 00000
NEXT_PUBLIC_EMAIL=info@techvalymas.lt
NEXT_PUBLIC_WORKING_HOURS=I–V 9:00–19:00, VI 10:00–15:00
NEXT_PUBLIC_DATA_CONTROLLER=Vardenis Pavardenis, individualios veiklos pažyma Nr. 000000

# --- Administravimas ---
ADMIN_PASSWORD=pakeiskite-i-ilga-slaptazodi
# Neprivaloma: atskiras sesijų slapukų parašo raktas (pagal nutylėjimą – ADMIN_PASSWORD)
SESSION_SECRET=
# Kur siųsti pranešimus apie naujas užklausas
ADMIN_EMAIL=you@example.com

# --- Duomenų bazė (PostgreSQL / Supabase). Jei tuščia – užsakymai saugomi data/orders.json ---
DATABASE_URL=
# true – jei DB reikalauja SSL (pvz. Supabase)
DATABASE_SSL=false

# --- El. laiškai: Resend ARBA SMTP. Jei abu tušti – laiškai tik išvedami į žurnalą ---
MAIL_FROM=TechValymas <info@techvalymas.lt>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Apsauga nuo botų (neprivaloma, Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analitika (neprivaloma, Plausible) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Savarankiškai talpinamam Plausible:
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.example.com/js/script.js
